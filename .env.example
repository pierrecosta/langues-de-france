# Copier ce fichier en .env (non versionné). Valeurs de démonstration uniquement.
POSTGRES_USER=demo
POSTGRES_PASSWORD=demo
POSTGRES_DB=demo

# Optionnel : clé API Context7 (limites de débit plus élevées)
CONTEXT7_API_KEY=

# Backend Django (voir backend/README.md)
DJANGO_SECRET_KEY=change-me-demo-only
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
LOG_LEVEL=INFO
