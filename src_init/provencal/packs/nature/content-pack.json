  "objectives": [
    { "id": "obj-1", "statement": "Associer quatre éléments du paysage (soleil, lune, mer, montagne) à leur nom provençal", "level": "debutant" },
    { "id": "obj-2", "statement": "Identifier le nom provençal de cinq plantes du terroir (lavande, romarin, thym, piment, petits pois)", "level": "debutant" },
    { "id": "obj-3", "statement": "Citer le sens de trois expressions provençales liées à la nature", "level": "intermediaire" }
  ],
  "facts": [
    { "id": "fact-1", "objectiveId": "obj-1", "sourceId": "src-1", "statement": "« Soleil » se dit « Soleu » en provençal (graphie du seed, à valider).", "importance": "essentiel", "provenance": "brouillon" },
    { "id": "fact-2", "objectiveId": "obj-1", "sourceId": "src-1", "statement": "« Lune » se dit « Luna » en provençal (graphie du seed, à valider).", "importance": "essentiel", "provenance": "brouillon" },
    { "id": "fact-3", "objectiveId": "obj-1", "sourceId": "src-1", "statement": "« Mer » se dit « Mar » en provençal (graphie du seed, à valider).", "importance": "essentiel", "provenance": "brouillon" },
    { "id": "fact-4", "objectiveId": "obj-1", "sourceId": "src-1", "statement": "« Montagne » se dit « Montanha » en provençal (graphie du seed, à valider).", "importance": "important", "provenance": "brouillon" },
    { "id": "fact-5", "objectiveId": "obj-2", "sourceId": "src-1", "statement": "« Lavande » se dit « Lavanda » en provençal (graphie du seed, à valider).", "importance": "essentiel", "provenance": "brouillon" },
    { "id": "fact-6", "objectiveId": "obj-2", "sourceId": "src-1", "statement": "« Romarin » se dit « Roumanieu » en provençal (graphie du seed, à valider).", "importance": "important", "provenance": "brouillon" },
    { "id": "fact-7", "objectiveId": "obj-2", "sourceId": "src-1", "statement": "« Thym » se dit « Farigoulo » en provençal (graphie du seed, à valider).", "importance": "important", "provenance": "brouillon" },
    { "id": "fact-8", "objectiveId": "obj-2", "sourceId": "src-1", "statement": "« Piment » se dit « Pimentoun » en provençal (graphie du seed, à valider).", "importance": "complementaire", "provenance": "brouillon" },
    { "id": "fact-9", "objectiveId": "obj-2", "sourceId": "src-1", "statement": "« Petits pois » se dit « Peses Verds » en provençal (graphie du seed, à valider).", "importance": "complementaire", "provenance": "brouillon" },
    { "id": "fact-10", "objectiveId": "obj-3", "sourceId": "src-2", "statement": "« Faire cantar li cigalo » signifie « Profiter de la vie » (sens du seed, à valider).", "importance": "important", "provenance": "brouillon" },
    { "id": "fact-11", "objectiveId": "obj-3", "sourceId": "src-2", "statement": "« Quand lou soulèu tomba » signifie « À la tombée de la nuit » (sens du seed, à valider).", "importance": "important", "provenance": "brouillon" },
    { "id": "fact-12", "objectiveId": "obj-3", "sourceId": "src-2", "statement": "« Entre dos aigo » signifie « Hésiter » (sens du seed, à valider).", "importance": "complementaire", "provenance": "brouillon" }
