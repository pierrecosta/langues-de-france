# Configuration locale sans secrets ; charger avec set -a et . ./.env.example.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
POSTGRES_DB=langues_backend
POSTGRES_USER=langues_backend
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
LOG_LEVEL=INFO
# DJANGO_SECRET_KEY et POSTGRES_PASSWORD doivent être fournis séparément.
